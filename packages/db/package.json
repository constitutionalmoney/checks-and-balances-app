{
  "name": "@cbc/db",
  "version": "0.0.0",
  "private": true,
  "description": "Prisma/PostgreSQL foundation and infrastructure readiness probes",
  "license": "Apache-2.0",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "db:validate": "prisma validate",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:seed": "tsx src/seed.ts"
  },
  "dependencies": {
    "@cbc/domain": "workspace:*",
    "@prisma/adapter-pg": "7.9.1",
    "@prisma/client": "7.9.1",
    "ioredis": "6.0.0",
    "pg": "8.22.0"
  },
  "devDependencies": {
    "@types/pg": "8.20.4",
    "prisma": "7.9.1"
  }
}
