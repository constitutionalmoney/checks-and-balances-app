generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum CommitteeState {
  PROPOSED             @map("proposed")
  FORMING              @map("forming")
  POLICY_REVIEW        @map("policy_review")
  TESTNET_PROVISIONING @map("testnet_provisioning")
  TESTNET_READY        @map("testnet_ready")
  PILOT_REVIEW         @map("pilot_review")
  PILOT_APPROVED       @map("pilot_approved")
  ACTIVE               @map("active")
  SUSPENDED            @map("suspended")
  RETIRED              @map("retired")

  @@map("committee_state")
}

enum PolicyVersionState {
  DRAFT    @map("draft")
  APPROVED @map("approved")
  RETIRED  @map("retired")

  @@map("policy_version_state")
}

enum IdempotencyState {
  STARTED   @map("started")
  COMPLETED @map("completed")
  REJECTED  @map("rejected")
  FAILED    @map("failed")

  @@map("idempotency_state")
}

enum AuditResult {
  SUCCEEDED @map("succeeded")
  REJECTED  @map("rejected")
  FAILED    @map("failed")

  @@map("audit_result")
}

enum OutboxState {
  PENDING          @map("pending")
  CLAIMED          @map("claimed")
  SUCCEEDED        @map("succeeded")
  RETRYABLE_FAILED @map("retryable_failed")
  TERMINAL_FAILED  @map("terminal_failed")
  DEAD_LETTER      @map("dead_letter")

  @@map("outbox_state")
}

enum VerusNetwork {
  VRSCTEST

  @@map("verus_network")
}

enum VerusJobState {
  PENDING          @map("pending")
  CLAIMED          @map("claimed")
  PREFLIGHT        @map("preflight")
  SUBMITTED        @map("submitted")
  CONFIRMING       @map("confirming")
  READBACK         @map("readback")
  VERIFIED         @map("verified")
  RETRYABLE_FAILED @map("retryable_failed")
  TERMINAL_FAILED  @map("terminal_failed")
  REORG_PENDING    @map("reorg_pending")

  @@map("verus_job_state")
}

model Jurisdiction {
  id                String      @id @db.Uuid
  externalReference String      @unique @map("external_reference")
  kind              String
  displayName       String      @map("display_name")
  boundaryReference String?     @map("boundary_reference")
  createdAt         DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  committees        Committee[]

  @@map("jurisdiction")
}

model Committee {
  id                String              @id @db.Uuid
  externalReference String              @unique @map("external_reference")
  slug              String              @unique
  displayName       String              @map("display_name")
  state             CommitteeState      @default(PROPOSED)
  jurisdictionId    String              @map("jurisdiction_id") @db.Uuid
  version           Int                 @default(1)
  createdAt         DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime            @updatedAt @map("updated_at") @db.Timestamptz(6)
  jurisdiction      Jurisdiction        @relation(fields: [jurisdictionId], references: [id], onDelete: Restrict)
  consentReceipts   ConsentReceipt[]
  idempotency       IdempotencyRecord[]
  auditEvents       AuditEvent[]
  outboxEvents      OutboxEvent[]
  verusJobs         VerusJob[]

  @@index([jurisdictionId, state])
  @@map("committee")
}

model ParticipantAccount {
  id                String           @id @db.Uuid
  externalReference String           @unique @map("external_reference")
  version           Int              @default(1)
  createdAt         DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)
  consentReceipts   ConsentReceipt[]

  @@map("participant_account")
}

model PolicyDocument {
  id        String          @id @db.Uuid
  policyKey String          @unique @map("policy_key")
  title     String
  createdAt DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  versions  PolicyVersion[]

  @@map("policy_document")
}

model PolicyVersion {
  id               String             @id @db.Uuid
  policyDocumentId String             @map("policy_document_id") @db.Uuid
  version          String
  state            PolicyVersionState @default(DRAFT)
  contentDigest    String             @map("content_digest")
  contentReference String?            @map("content_reference")
  effectiveAt      DateTime?          @map("effective_at") @db.Timestamptz(6)
  retiredAt        DateTime?          @map("retired_at") @db.Timestamptz(6)
  createdAt        DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  policyDocument   PolicyDocument     @relation(fields: [policyDocumentId], references: [id], onDelete: Restrict)
  consentReceipts  ConsentReceipt[]

  @@unique([policyDocumentId, version])
  @@index([state, effectiveAt])
  @@map("policy_version")
}

model ConsentReceipt {
  id              String             @id @db.Uuid
  participantId   String             @map("participant_id") @db.Uuid
  committeeId     String?            @map("committee_id") @db.Uuid
  policyVersionId String             @map("policy_version_id") @db.Uuid
  purpose         String
  acknowledgedAt  DateTime           @map("acknowledged_at") @db.Timestamptz(6)
  withdrawnAt     DateTime?          @map("withdrawn_at") @db.Timestamptz(6)
  createdAt       DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  participant     ParticipantAccount @relation(fields: [participantId], references: [id], onDelete: Restrict)
  committee       Committee?         @relation(fields: [committeeId], references: [id], onDelete: Restrict)
  policyVersion   PolicyVersion      @relation(fields: [policyVersionId], references: [id], onDelete: Restrict)

  @@unique([participantId, policyVersionId, purpose])
  @@index([committeeId, acknowledgedAt])
  @@map("consent_receipt")
}

model IdempotencyRecord {
  id             String           @id @db.Uuid
  scope          String
  keyHash        String           @map("key_hash")
  requestDigest  String           @map("request_digest")
  command        String
  actorType      String           @map("actor_type")
  actorReference String           @map("actor_reference")
  committeeId    String?          @map("committee_id") @db.Uuid
  state          IdempotencyState @default(STARTED)
  resultDigest   String?          @map("result_digest")
  startedAt      DateTime         @default(now()) @map("started_at") @db.Timestamptz(6)
  completedAt    DateTime?        @map("completed_at") @db.Timestamptz(6)
  expiresAt      DateTime?        @map("expires_at") @db.Timestamptz(6)
  committee      Committee?       @relation(fields: [committeeId], references: [id], onDelete: Restrict)

  @@unique([scope, keyHash])
  @@index([state, expiresAt])
  @@map("idempotency_record")
}

model AuditChainHead {
  chainKey  String   @id @map("chain_key")
  eventId   String?  @map("event_id") @db.Uuid
  eventHash String?  @map("event_hash")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("audit_chain_head")
}

model AuditEvent {
  sequence           BigInt      @id @default(autoincrement())
  id                 String      @unique @db.Uuid
  chainKey           String      @map("chain_key")
  previousHash       String?     @map("previous_hash")
  eventHash          String      @unique @map("event_hash")
  actorType          String      @map("actor_type")
  actorReference     String      @map("actor_reference")
  committeeId        String?     @map("committee_id") @db.Uuid
  command            String
  targetType         String      @map("target_type")
  targetReference    String      @map("target_reference")
  priorState         String?     @map("prior_state")
  newState           String?     @map("new_state")
  policyVersion      String?     @map("policy_version")
  softwareVersion    String      @map("software_version")
  reasonCategory     String?     @map("reason_category")
  authentication     String      @map("authentication_strength")
  correlationId      String      @map("correlation_id")
  idempotencyKeyHash String?     @map("idempotency_key_hash")
  result             AuditResult
  occurredAt         DateTime    @default(now()) @map("occurred_at") @db.Timestamptz(6)
  committee          Committee?  @relation(fields: [committeeId], references: [id], onDelete: Restrict)

  @@index([chainKey, sequence])
  @@index([committeeId, occurredAt])
  @@index([correlationId])
  @@map("audit_event")
}

model OutboxEvent {
  id                 String          @id @db.Uuid
  committeeId        String?         @map("committee_id") @db.Uuid
  eventType          String          @map("event_type")
  aggregateType      String          @map("aggregate_type")
  aggregateReference String          @map("aggregate_reference")
  schemaVersion      String          @map("schema_version")
  payloadReference   String          @map("payload_reference")
  payloadDigest      String          @map("payload_digest")
  idempotencyKeyHash String          @unique @map("idempotency_key_hash")
  state              OutboxState     @default(PENDING)
  availableAt        DateTime        @default(now()) @map("available_at") @db.Timestamptz(6)
  leaseOwner         String?         @map("lease_owner")
  leaseExpiresAt     DateTime?       @map("lease_expires_at") @db.Timestamptz(6)
  attemptCount       Int             @default(0) @map("attempt_count")
  lastErrorClass     String?         @map("last_error_class")
  createdAt          DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  completedAt        DateTime?       @map("completed_at") @db.Timestamptz(6)
  committee          Committee?      @relation(fields: [committeeId], references: [id], onDelete: Restrict)
  attempts           OutboxAttempt[]
  verusJob           VerusJob?

  @@index([state, availableAt])
  @@index([leaseExpiresAt])
  @@index([committeeId, createdAt])
  @@map("outbox_event")
}

model OutboxAttempt {
  id            String      @id @db.Uuid
  outboxEventId String      @map("outbox_event_id") @db.Uuid
  attempt       Int
  worker        String
  result        AuditResult
  errorClass    String?     @map("error_class")
  startedAt     DateTime    @map("started_at") @db.Timestamptz(6)
  finishedAt    DateTime    @map("finished_at") @db.Timestamptz(6)
  outboxEvent   OutboxEvent @relation(fields: [outboxEventId], references: [id], onDelete: Restrict)

  @@unique([outboxEventId, attempt])
  @@map("outbox_attempt")
}

model VerusJob {
  id               String        @id @db.Uuid
  outboxEventId    String        @unique @map("outbox_event_id") @db.Uuid
  committeeId      String?       @map("committee_id") @db.Uuid
  network          VerusNetwork  @default(VRSCTEST)
  chainId          String        @map("chain_id")
  operationType    String        @map("operation_type")
  subjectReference String        @map("subject_reference")
  vdxfKey          String        @default("") @map("vdxf_key")
  manifestDigest   String        @map("manifest_digest")
  state            VerusJobState @default(PENDING)
  transactionId    String?       @map("transaction_id")
  blockHeight      BigInt?       @map("block_height")
  blockHash        String?       @map("block_hash")
  readbackDigest   String?       @map("readback_digest")
  createdAt        DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)
  outboxEvent      OutboxEvent   @relation(fields: [outboxEventId], references: [id], onDelete: Restrict)
  committee        Committee?    @relation(fields: [committeeId], references: [id], onDelete: Restrict)

  @@unique([network, operationType, subjectReference, vdxfKey, manifestDigest])
  @@index([state, createdAt])
  @@index([committeeId, createdAt])
  @@map("verus_job")
}
