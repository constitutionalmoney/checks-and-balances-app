  id                String              @id @db.Uuid
  externalReference String              @unique @map("external_reference")
  participantId     String              @map("participant_id") @db.Uuid
  committeeId       String?             @map("committee_id") @db.Uuid
  targetType        String              @map("target_type")
  targetReference   String              @map("target_reference")
  fieldCategory     String              @map("field_category")
  policyVersionId   String              @map("policy_version_id") @db.Uuid
  state             PrivacyRequestState @default(REQUESTED)
  createdAt         DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  completedAt       DateTime?           @map("completed_at") @db.Timestamptz(6)
  participant       ParticipantAccount  @relation(fields: [participantId], references: [id], onDelete: Restrict)

  @@index([committeeId, state])
  @@map("correction_request")
}

model PrivacyRightsRequest {
  id                  String              @id @db.Uuid
  externalReference   String              @unique @map("external_reference")
  participantId       String              @map("participant_id") @db.Uuid
  committeeId         String?             @map("committee_id") @db.Uuid
  kind                PrivacyRequestKind
  policyVersionId     String              @map("policy_version_id") @db.Uuid
  state               PrivacyRequestState @default(REQUESTED)
  identityProofDigest String?             @map("identity_proof_digest")
  version             Int                 @default(1)
  requestedAt         DateTime            @default(now()) @map("requested_at") @db.Timestamptz(6)
  completedAt         DateTime?           @map("completed_at") @db.Timestamptz(6)
  committee           Committee?          @relation(fields: [committeeId], references: [id], onDelete: Restrict)
  participant         ParticipantAccount  @relation(fields: [participantId], references: [id], onDelete: Restrict)

  @@index([committeeId, state])
  @@index([participantId, requestedAt])
  @@map("privacy_rights_request")
}

model RelyingPartyClient {
  id                String                    @id @db.Uuid
  externalReference String                    @unique @map("external_reference")
  committeeId       String?                   @map("committee_id") @db.Uuid
  policyVersionId   String                    @map("policy_version_id") @db.Uuid
  state             RelyingPartyClientState   @default(PROPOSED)
  scopesReference   String                    @map("scopes_reference")
  scopesDigest      String                    @map("scopes_digest")
  termsVersion      String                    @map("terms_version")
  version           Int                       @default(1)
  createdAt         DateTime                  @default(now()) @map("created_at") @db.Timestamptz(6)
  committee         Committee?                @relation(fields: [committeeId], references: [id], onDelete: Restrict)
  accessAudits      RelyingPartyAccessAudit[]

  @@index([committeeId, state])
  @@map("relying_party_client")
}

model RelyingPartyAccessAudit {
  sequence         BigInt             @id @default(autoincrement())
  id               String             @unique @db.Uuid
  clientId         String             @map("client_id") @db.Uuid
  subjectReference String             @map("subject_reference")
  purpose          String
  result           AuditResult
  policyVersion    String             @map("policy_version")
  occurredAt       DateTime           @default(now()) @map("occurred_at") @db.Timestamptz(6)
  client           RelyingPartyClient @relation(fields: [clientId], references: [id], onDelete: Restrict)

  @@index([clientId, occurredAt])
  @@map("relying_party_access_audit")
}

model Notification {
  id                   String              @id @db.Uuid
  externalReference    String              @unique @map("external_reference")
  committeeId          String?             @map("committee_id") @db.Uuid
  participantId        String?             @map("participant_id") @db.Uuid
  authAccountId        String              @map("auth_account_id") @db.Uuid
  policyVersionId      String              @map("policy_version_id") @db.Uuid
  state                NotificationState   @default(PENDING)
  channel              ContactChannel
  destinationReference String              @map("destination_reference")
  templateVersion      String              @map("template_version")
  messageType          String              @map("message_type")
  availableAt          DateTime            @default(now()) @map("available_at") @db.Timestamptz(6)
  deliveredAt          DateTime?           @map("delivered_at") @db.Timestamptz(6)
  version              Int                 @default(1)
  createdAt            DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  committee            Committee?          @relation(fields: [committeeId], references: [id], onDelete: Restrict)
  participant          ParticipantAccount? @relation(fields: [participantId], references: [id], onDelete: Restrict)
  authAccount          AuthAccount         @relation(fields: [authAccountId], references: [id], onDelete: Restrict)

  @@index([state, availableAt])
  @@index([committeeId, createdAt])
  @@map("notification")
}

model ProtocolRelease {
  id                 String               @id @db.Uuid
  externalReference  String               @unique @map("external_reference")
  version            String               @unique
  state              ProtocolReleaseState @default(DRAFT)
  softwareVersion    String               @map("software_version")
  policyBundleDigest String               @map("policy_bundle_digest")
  createdAt          DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  effectiveAt        DateTime?            @map("effective_at") @db.Timestamptz(6)
  capabilities       CapabilityStatus[]

  @@map("protocol_release")
}

model CapabilityStatus {
  id                String          @id @db.Uuid
  protocolReleaseId String          @map("protocol_release_id") @db.Uuid
  capabilityKey     String          @map("capability_key")
  state             CapabilityState @default(DISABLED)
  network           VerusNetwork?
  reasonCategory    String          @map("reason_category")
  release           ProtocolRelease @relation(fields: [protocolReleaseId], references: [id], onDelete: Restrict)

  @@unique([protocolReleaseId, capabilityKey])
  @@map("capability_status")
}

model AnchorRecord {
  id                String       @id @db.Uuid
  externalReference String       @unique @map("external_reference")
  committeeId       String?      @map("committee_id") @db.Uuid
  outboxEventId     String       @unique @map("outbox_event_id") @db.Uuid
  network           VerusNetwork @default(VRSCTEST)
  chainId           String       @map("chain_id")
  anchorType        String       @map("anchor_type")
  subjectReference  String       @map("subject_reference")
  vdxfKey           String       @map("vdxf_key")
  manifestDigest    String       @map("manifest_digest")
  state             AnchorState  @default(PENDING)
  transactionId     String?      @map("transaction_id")
  blockHeight       BigInt?      @map("block_height")
  blockHash         String?      @map("block_hash")
  readbackDigest    String?      @map("readback_digest")
  version           Int          @default(1)
  createdAt         DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)
  committee         Committee?   @relation(fields: [committeeId], references: [id], onDelete: Restrict)

  @@unique([network, anchorType, subjectReference, vdxfKey, manifestDigest])
  @@index([committeeId, state])
  @@map("anchor_record")
}
