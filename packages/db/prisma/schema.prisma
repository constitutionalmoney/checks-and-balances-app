generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum CommitteeState {
  PROPOSED             @map("proposed")
  FORMING              @map("forming")
  POLICY_REVIEW        @map("policy_review")
  TESTNET_PROVISIONING @map("testnet_provisioning")
  TESTNET_READY        @map("testnet_ready")
  PILOT_REVIEW         @map("pilot_review")
  PILOT_APPROVED       @map("pilot_approved")
  ACTIVE               @map("active")
  SUSPENDED            @map("suspended")
  RETIRED              @map("retired")

  @@map("committee_state")
}

enum PolicyVersionState {
  DRAFT    @map("draft")
  APPROVED @map("approved")
  RETIRED  @map("retired")

  @@map("policy_version_state")
}

enum IdempotencyState {
  STARTED   @map("started")
  COMPLETED @map("completed")
  REJECTED  @map("rejected")
  FAILED    @map("failed")

  @@map("idempotency_state")
}

enum AuditResult {
  SUCCEEDED @map("succeeded")
  REJECTED  @map("rejected")
  FAILED    @map("failed")

  @@map("audit_result")
}

enum OutboxState {
  PENDING          @map("pending")
  CLAIMED          @map("claimed")
  SUCCEEDED        @map("succeeded")
  RETRYABLE_FAILED @map("retryable_failed")
  TERMINAL_FAILED  @map("terminal_failed")
  DEAD_LETTER      @map("dead_letter")

  @@map("outbox_state")
}

enum VerusNetwork {
  VRSCTEST

  @@map("verus_network")
}

enum VerusJobState {
  PENDING          @map("pending")
  CLAIMED          @map("claimed")
  PREFLIGHT        @map("preflight")
  SUBMITTED        @map("submitted")
  CONFIRMING       @map("confirming")
  READBACK         @map("readback")
  VERIFIED         @map("verified")
  RETRYABLE_FAILED @map("retryable_failed")
  TERMINAL_FAILED  @map("terminal_failed")
  REORG_PENDING    @map("reorg_pending")

  @@map("verus_job_state")
}

enum MembershipState {
  PROPOSED  @map("proposed")
  ACTIVE    @map("active")
  SUSPENDED @map("suspended")
  RETIRED   @map("retired")

  @@map("membership_state")
}

enum ReadinessState {
  PENDING        @map("pending")
  IN_REVIEW      @map("in_review")
  SATISFIED      @map("satisfied")
  BLOCKED        @map("blocked")
  NOT_APPLICABLE @map("not_applicable")

  @@map("readiness_state")
}

enum VerificationState {
  REQUESTED              @map("requested")
  SCHEDULED              @map("scheduled")
  CHECKED_IN             @map("checked_in")
  UNDER_REVIEW           @map("under_review")
  APPROVED               @map("approved")
  REJECTED               @map("rejected")
  NEEDS_MORE_INFORMATION @map("needs_more_information")
  WITHDRAWN              @map("withdrawn")
  ISSUANCE_PENDING       @map("issuance_pending")
  ISSUED                 @map("issued")
  ACTIVE                 @map("active")
  EXPIRED                @map("expired")
  REVOKED                @map("revoked")
  SUPERSEDED             @map("superseded")
  APPEALED               @map("appealed")
  APPEAL_UPHELD          @map("appeal_upheld")
  APPEAL_DENIED          @map("appeal_denied")
  APPEAL_REMANDED        @map("appeal_remanded")

  @@map("verification_state")
}

enum SessionState {
  DRAFT     @map("draft")
  SCHEDULED @map("scheduled")
  OPEN      @map("open")
  CLOSED    @map("closed")
  CANCELLED @map("cancelled")

  @@map("session_state")
}

enum AppointmentState {
  RESERVED   @map("reserved")
  CONFIRMED  @map("confirmed")
  CHECKED_IN @map("checked_in")
  COMPLETED  @map("completed")
  CANCELLED  @map("cancelled")
  NO_SHOW    @map("no_show")

  @@map("appointment_state")
}

enum AttendanceState {
  EXPECTED   @map("expected")
  CHECKED_IN @map("checked_in")
  PRESENT    @map("present")
  DEPARTED   @map("departed")
  ABSENT     @map("absent")

  @@map("attendance_state")
}

enum EvidenceReviewResult {
  MATCHED                @map("matched")
  NOT_MATCHED            @map("not_matched")
  NEEDS_MORE_INFORMATION @map("needs_more_information")

  @@map("evidence_review_result")
}

enum EvidenceRetention {
  NOT_RETAINED @map("not_retained")

  @@map("evidence_retention")
}

enum ReviewDecisionState {
  APPROVED               @map("approved")
  REJECTED               @map("rejected")
  NEEDS_MORE_INFORMATION @map("needs_more_information")

  @@map("review_decision_state")
}

enum AttestationState {
  ISSUED     @map("issued")
  ACTIVE     @map("active")
  EXPIRED    @map("expired")
  REVOKED    @map("revoked")
  SUPERSEDED @map("superseded")

  @@map("attestation_state")
}

enum RenewalCycleState {
  DRAFT              @map("draft")
  SNAPSHOT_COMMITTED @map("snapshot_committed")
  SELECTION_PENDING  @map("selection_pending")
  SELECTION_READY    @map("selection_ready")
  NOTICES_PENDING    @map("notices_pending")
  IN_PROGRESS        @map("in_progress")
  REPORTING          @map("reporting")
  PUBLISHED          @map("published")
  CANCELLED          @map("cancelled")

  @@map("renewal_cycle_state")
}

enum WalletChallengeState {
  CREATED           @map("created")
  PRESENTED         @map("presented")
  RESPONSE_RECEIVED @map("response_received")
  CONSUMED          @map("consumed")
  EXPIRED           @map("expired")
  REJECTED          @map("rejected")

  @@map("wallet_challenge_state")
}

enum ConsentState {
  PENDING      @map("pending")
  ACKNOWLEDGED @map("acknowledged")
  WITHDRAWN    @map("withdrawn")

  @@map("consent_state")
}

enum AppealState {
  OPENED       @map("opened")
  ASSIGNED     @map("assigned")
  UNDER_REVIEW @map("under_review")
  UPHELD       @map("upheld")
  DENIED       @map("denied")
  REMANDED     @map("remanded")
  WITHDRAWN    @map("withdrawn")

  @@map("appeal_state")
}

enum PrivacyRequestKind {
  ACCESS      @map("access")
  CORRECTION  @map("correction")
  DELETION    @map("deletion")
  RESTRICTION @map("restriction")

  @@map("privacy_request_kind")
}

enum PrivacyRequestState {
  REQUESTED          @map("requested")
  IDENTITY_CONFIRMED @map("identity_confirmed")
  PROCESSING         @map("processing")
  COMPLETED          @map("completed")
  DENIED             @map("denied")
  WITHDRAWN          @map("withdrawn")

  @@map("privacy_request_state")
}

enum NotificationState {
  PENDING          @map("pending")
  CLAIMED          @map("claimed")
  DELIVERED        @map("delivered")
  RETRYABLE_FAILED @map("retryable_failed")
  TERMINAL_FAILED  @map("terminal_failed")
  DEAD_LETTER      @map("dead_letter")
  CANCELLED        @map("cancelled")

  @@map("notification_state")
}

enum RelyingPartyClientState {
  PROPOSED        @map("proposed")
  SECURITY_REVIEW @map("security_review")
  APPROVED        @map("approved")
  ACTIVE          @map("active")
  SUSPENDED       @map("suspended")
  REVOKED         @map("revoked")

  @@map("relying_party_client_state")
}

enum ContactChannel {
  EMAIL @map("email")

  @@map("contact_channel")
}

enum CredentialState {
  ACTIVE   @map("active")
  DISABLED @map("disabled")
  REVOKED  @map("revoked")

  @@map("credential_state")
}

enum IdentityLinkState {
  ACTIVE                @map("active")
  REVALIDATION_REQUIRED @map("revalidation_required")
  UNLINKED              @map("unlinked")

  @@map("identity_link_state")
}

enum ProtocolReleaseState {
  DRAFT   @map("draft")
  TESTNET @map("testnet")
  RETIRED @map("retired")

  @@map("protocol_release_state")
}

enum CapabilityState {
  DISABLED      @map("disabled")
  SPECIFICATION @map("specification")
  VRSCTEST_DEMO @map("vrsctest_demo")

  @@map("capability_state")
}

enum AnchorState {
  PENDING          @map("pending")
  SUBMITTED        @map("submitted")
  CONFIRMING       @map("confirming")
  READBACK         @map("readback")
  VERIFIED         @map("verified")
  RETRYABLE_FAILED @map("retryable_failed")
  TERMINAL_FAILED  @map("terminal_failed")
  REORG_PENDING    @map("reorg_pending")

  @@map("anchor_state")
}

enum AuthTrustDomain {
  PARTICIPANT @map("participant")
  COMMITTEE   @map("committee")

  @@map("auth_trust_domain")
}

enum AuthAccountState {
  INVITED   @map("invited")
  ACTIVE    @map("active")
  LOCKED    @map("locked")
  SUSPENDED @map("suspended")
  CLOSED    @map("closed")

  @@map("auth_account_state")
}

enum AuthenticationStrength {
  VERIFIED_EMAIL @map("verified_email")
  PASSKEY        @map("passkey")
  RECOVERY       @map("recovery")

  @@map("authentication_strength")
}

enum AuthSessionState {
  ACTIVE  @map("active")
  REVOKED @map("revoked")
  EXPIRED @map("expired")

  @@map("auth_session_state")
}

enum AuthChallengeKind {
  PASSKEY_REGISTRATION   @map("passkey_registration")
  PASSKEY_AUTHENTICATION @map("passkey_authentication")
  EMAIL_SIGN_IN          @map("email_sign_in")
  ACCOUNT_RECOVERY       @map("account_recovery")
  RECOVERY_GRANT         @map("recovery_grant")
  EMAIL_CHANGE           @map("email_change")

  @@map("auth_challenge_kind")
}

enum AuthChallengeState {
  PENDING  @map("pending")
  CONSUMED @map("consumed")
  EXPIRED  @map("expired")
  REJECTED @map("rejected")

  @@map("auth_challenge_state")
}

enum CommitteeAccessState {
  INVITED   @map("invited")
  APPROVED  @map("approved")
  ACTIVE    @map("active")
  SUSPENDED @map("suspended")
  REVOKED   @map("revoked")

  @@map("committee_access_state")
}

enum ConsentAction {
  ACCEPTED  @map("accepted")
  DECLINED  @map("declined")
  WITHDRAWN @map("withdrawn")

  @@map("consent_action")
}

model Jurisdiction {
  id                String      @id @db.Uuid
  externalReference String      @unique @map("external_reference")
  kind              String
  displayName       String      @map("display_name")
  boundaryReference String?     @map("boundary_reference")
  createdAt         DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  committees        Committee[]

  @@map("jurisdiction")
}

model Committee {
  id                   String                      @id @db.Uuid
  externalReference    String                      @unique @map("external_reference")
  slug                 String                      @unique
  displayName          String                      @map("display_name")
  state                CommitteeState              @default(PROPOSED)
  jurisdictionId       String                      @map("jurisdiction_id") @db.Uuid
  version              Int                         @default(1)
  createdAt            DateTime                    @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime                    @updatedAt @map("updated_at") @db.Timestamptz(6)
  jurisdiction         Jurisdiction                @relation(fields: [jurisdictionId], references: [id], onDelete: Restrict)
  consentReceipts      ConsentReceipt[]
  idempotency          IdempotencyRecord[]
  auditEvents          AuditEvent[]
  outboxEvents         OutboxEvent[]
  verusJobs            VerusJob[]
  members              CommitteeMember[]
  roles                CommitteeRole[]
  readinessItems       ReadinessChecklistItem[]
  verificationRequests VerificationRequest[]
  verificationSessions VerificationSession[]
  appointments         Appointment[]
  attendanceRecords    SessionAttendance[]
  evidenceReviews      EvidenceReviewRecord[]
  reviewDecisions      ReviewDecision[]
  attestations         Attestation[]
  renewalCycles        RenewalCycle[]
  appeals              Appeal[]
  privacyRequests      PrivacyRightsRequest[]
  relyingPartyClients  RelyingPartyClient[]
  notifications        Notification[]
  anchorRecords        AnchorRecord[]
  authAccess           AuthCommitteeAccess[]
  reviewerAssignments  ReviewerSessionAssignment[]

  @@index([jurisdictionId, state])
  @@map("committee")
}

model ParticipantAccount {
  id                   String                 @id @db.Uuid
  externalReference    String                 @unique @map("external_reference")
  version              Int                    @default(1)
  createdAt            DateTime               @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime               @updatedAt @map("updated_at") @db.Timestamptz(6)
  consentReceipts      ConsentReceipt[]
  contactPreferences   ContactPreference[]
  committeeMemberships CommitteeMember[]
  passkeys             PasskeyMetadata[]
  verusIdentityLinks   VerusIdentityLink[]
  walletChallenges     WalletChallenge[]
  verificationRequests VerificationRequest[]
  appointments         Appointment[]
  attendanceRecords    SessionAttendance[]
  attestations         Attestation[]
  appeals              Appeal[]
  privacyRequests      PrivacyRightsRequest[]
  notifications        Notification[]
  correctionRequests   CorrectionRequest[]
  authAccounts         AuthAccount[]

  @@map("participant_account")
}

model AuthAccount {
  id                  String                @id @db.Uuid
  externalReference   String                @unique @map("external_reference")
  trustDomain         AuthTrustDomain       @map("trust_domain")
  state               AuthAccountState      @default(INVITED)
  participantId       String?               @map("participant_id") @db.Uuid
  version             Int                   @default(1)
  lockedAt            DateTime?             @map("locked_at") @db.Timestamptz(6)
  suspendedAt         DateTime?             @map("suspended_at") @db.Timestamptz(6)
  recoveredAt         DateTime?             @map("recovered_at") @db.Timestamptz(6)
  closedAt            DateTime?             @map("closed_at") @db.Timestamptz(6)
  createdAt           DateTime              @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime              @updatedAt @map("updated_at") @db.Timestamptz(6)
  participant         ParticipantAccount?   @relation(fields: [participantId], references: [id], onDelete: Restrict)
  sessions            AuthSession[]
  challenges          AuthChallenge[]
  contactPreferences  ContactPreference[]
  passkeys            PasskeyMetadata[]
  consentReceipts     ConsentReceipt[]
  notifications       Notification[]
  committeeAccess     AuthCommitteeAccess[]
  privilegedApprovals PrivilegedApproval[]  @relation("PrivilegedApprover")
  privilegedRequests  PrivilegedApproval[]  @relation("PrivilegedRequester")

  @@unique([participantId, trustDomain])
  @@index([trustDomain, state])
  @@map("auth_account")
}

model AuthSession {
  id                     String                 @id @db.Uuid
  accountId              String                 @map("account_id") @db.Uuid
  trustDomain            AuthTrustDomain        @map("trust_domain")
  audience               String
  tokenDigest            String                 @unique @map("token_digest")
  csrfDigest             String                 @map("csrf_digest")
  keyVersion             String                 @map("key_version")
  authenticationStrength AuthenticationStrength @map("authentication_strength")
  state                  AuthSessionState       @default(ACTIVE)
  deviceLabel            String                 @map("device_label")
  authenticatedAt        DateTime               @map("authenticated_at") @db.Timestamptz(6)
  reauthenticatedAt      DateTime?              @map("reauthenticated_at") @db.Timestamptz(6)
  lastSeenAt             DateTime               @map("last_seen_at") @db.Timestamptz(6)
  idleExpiresAt          DateTime               @map("idle_expires_at") @db.Timestamptz(6)
  absoluteExpiresAt      DateTime               @map("absolute_expires_at") @db.Timestamptz(6)
  revokedAt              DateTime?              @map("revoked_at") @db.Timestamptz(6)
  revocationReason       String?                @map("revocation_reason")
  createdAt              DateTime               @default(now()) @map("created_at") @db.Timestamptz(6)
  account                AuthAccount            @relation(fields: [accountId], references: [id], onDelete: Restrict)

  @@index([accountId, state, absoluteExpiresAt])
  @@index([trustDomain, tokenDigest])
  @@map("auth_session")
}

model AuthChallenge {
  id                   String             @id @db.Uuid
  accountId            String?            @map("account_id") @db.Uuid
  trustDomain          AuthTrustDomain    @map("trust_domain")
  kind                 AuthChallengeKind
  state                AuthChallengeState @default(PENDING)
  secretDigest         String             @unique @map("secret_digest")
  destinationReference String?            @map("destination_reference")
  lookupDigest         String?            @map("lookup_digest")
  attemptCount         Int                @default(0) @map("attempt_count")
  maximumAttempts      Int                @default(1) @map("maximum_attempts")
  expiresAt            DateTime           @map("expires_at") @db.Timestamptz(6)
  consumedAt           DateTime?          @map("consumed_at") @db.Timestamptz(6)
  createdAt            DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  account              AuthAccount?       @relation(fields: [accountId], references: [id], onDelete: Restrict)

  @@index([trustDomain, kind, state, expiresAt])
  @@index([accountId, kind, state])
  @@map("auth_challenge")
}

model AuthRateLimitBucket {
  keyDigest       String   @id @map("key_digest")
  bucket          String
  attemptCount    Int      @default(1) @map("attempt_count")
  windowStartedAt DateTime @map("window_started_at") @db.Timestamptz(6)
  expiresAt       DateTime @map("expires_at") @db.Timestamptz(6)

  @@index([expiresAt])
  @@map("auth_rate_limit_bucket")
}

model AuthCommitteeAccess {
  id                  String               @id @db.Uuid
  accountId           String               @map("account_id") @db.Uuid
  committeeId         String               @map("committee_id") @db.Uuid
  memberId            String?              @map("member_id") @db.Uuid
  state               CommitteeAccessState @default(INVITED)
  invitedByReference  String               @map("invited_by_reference")
  approvedByReference String?              @map("approved_by_reference")
  invitedAt           DateTime             @map("invited_at") @db.Timestamptz(6)
  approvedAt          DateTime?            @map("approved_at") @db.Timestamptz(6)
  activatedAt         DateTime?            @map("activated_at") @db.Timestamptz(6)
  suspendedAt         DateTime?            @map("suspended_at") @db.Timestamptz(6)
  revokedAt           DateTime?            @map("revoked_at") @db.Timestamptz(6)
  account             AuthAccount          @relation(fields: [accountId], references: [id], onDelete: Restrict)
  committee           Committee            @relation(fields: [committeeId], references: [id], onDelete: Restrict)
  member              CommitteeMember?     @relation(fields: [memberId, committeeId], references: [id, committeeId], onDelete: Restrict)

  @@unique([accountId, committeeId])
  @@index([committeeId, state])
  @@map("auth_committee_access")
}

model PrivilegedApproval {
  id                     String      @id @db.Uuid
  operationReference     String      @map("operation_reference")
  action                 String
  targetReference        String      @map("target_reference")
  requesterAccountId     String      @map("requester_account_id") @db.Uuid
  approverAccountId      String      @map("approver_account_id") @db.Uuid
  policyVersionReference String      @map("policy_version_reference")
  approvedAt             DateTime    @map("approved_at") @db.Timestamptz(6)
  expiresAt              DateTime    @map("expires_at") @db.Timestamptz(6)
  consumedAt             DateTime?   @map("consumed_at") @db.Timestamptz(6)
  requester              AuthAccount @relation("PrivilegedRequester", fields: [requesterAccountId], references: [id], onDelete: Restrict)
  approver               AuthAccount @relation("PrivilegedApprover", fields: [approverAccountId], references: [id], onDelete: Restrict)

  @@unique([operationReference, approverAccountId])
  @@index([operationReference, expiresAt])
  @@map("privileged_approval")
}

model PolicyDocument {
  id        String          @id @db.Uuid
  policyKey String          @unique @map("policy_key")
  title     String
  createdAt DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  versions  PolicyVersion[]

  @@map("policy_document")
}

model PolicyVersion {
  id                  String                      @id @db.Uuid
  policyDocumentId    String                      @map("policy_document_id") @db.Uuid
  version             String
  state               PolicyVersionState          @default(DRAFT)
  contentDigest       String                      @map("content_digest")
  contentReference    String?                     @map("content_reference")
  effectiveAt         DateTime?                   @map("effective_at") @db.Timestamptz(6)
  retiredAt           DateTime?                   @map("retired_at") @db.Timestamptz(6)
  createdAt           DateTime                    @default(now()) @map("created_at") @db.Timestamptz(6)
  policyDocument      PolicyDocument              @relation(fields: [policyDocumentId], references: [id], onDelete: Restrict)
  consentReceipts     ConsentReceipt[]
  reviewerAssignments ReviewerSessionAssignment[]

  @@unique([policyDocumentId, version])
  @@index([state, effectiveAt])
  @@map("policy_version")
}

model ConsentReceipt {
  id                    String              @id @db.Uuid
  externalReference     String              @unique @map("external_reference")
  participantId         String?             @map("participant_id") @db.Uuid
  authAccountId         String              @map("auth_account_id") @db.Uuid
  committeeId           String?             @map("committee_id") @db.Uuid
  policyVersionId       String              @map("policy_version_id") @db.Uuid
  purpose               String
  presentationReference String              @map("presentation_reference")
  presentationDigest    String              @map("presentation_digest")
  action                ConsentAction
  state                 ConsentState        @default(ACKNOWLEDGED)
  version               Int                 @default(1)
  acknowledgedAt        DateTime?           @map("acknowledged_at") @db.Timestamptz(6)
  presentedAt           DateTime            @map("presented_at") @db.Timestamptz(6)
  actedAt               DateTime            @map("acted_at") @db.Timestamptz(6)
  withdrawnAt           DateTime?           @map("withdrawn_at") @db.Timestamptz(6)
  createdAt             DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  participant           ParticipantAccount? @relation(fields: [participantId], references: [id], onDelete: Restrict)
  authAccount           AuthAccount         @relation(fields: [authAccountId], references: [id], onDelete: Restrict)
  committee             Committee?          @relation(fields: [committeeId], references: [id], onDelete: Restrict)
  policyVersion         PolicyVersion       @relation(fields: [policyVersionId], references: [id], onDelete: Restrict)

  @@unique([authAccountId, policyVersionId, purpose, action], map: "consent_receipt_account_policy_purpose_action_key")
  @@index([committeeId, acknowledgedAt])
  @@map("consent_receipt")
}

model IdempotencyRecord {
  id              String           @id @db.Uuid
  scope           String
  keyHash         String           @map("key_hash")
  requestDigest   String           @map("request_digest")
  command         String
  actorType       String           @map("actor_type")
  actorReference  String           @map("actor_reference")
  committeeId     String?          @map("committee_id") @db.Uuid
  state           IdempotencyState @default(STARTED)
  resultDigest    String?          @map("result_digest")
  resultReference String?          @map("result_reference")
  resultState     String?          @map("result_state")
  resultVersion   Int?             @map("result_version")
  startedAt       DateTime         @default(now()) @map("started_at") @db.Timestamptz(6)
  completedAt     DateTime?        @map("completed_at") @db.Timestamptz(6)
  expiresAt       DateTime?        @map("expires_at") @db.Timestamptz(6)
  committee       Committee?       @relation(fields: [committeeId], references: [id], onDelete: Restrict)

  @@unique([scope, keyHash])
  @@index([state, expiresAt])
  @@map("idempotency_record")
}

model AuditChainHead {
  chainKey  String   @id @map("chain_key")
  eventId   String?  @map("event_id") @db.Uuid
  eventHash String?  @map("event_hash")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("audit_chain_head")
}

model AuditEvent {
  sequence           BigInt      @id @default(autoincrement())
  id                 String      @unique @db.Uuid
  chainKey           String      @map("chain_key")
  previousHash       String?     @map("previous_hash")
  eventHash          String      @unique @map("event_hash")
  actorType          String      @map("actor_type")
  actorReference     String      @map("actor_reference")
  committeeId        String?     @map("committee_id") @db.Uuid
  command            String
  targetType         String      @map("target_type")
  targetReference    String      @map("target_reference")
  priorState         String?     @map("prior_state")
  newState           String?     @map("new_state")
  policyVersion      String?     @map("policy_version")
  softwareVersion    String      @map("software_version")
