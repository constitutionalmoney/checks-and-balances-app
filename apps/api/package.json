{
  "name": "@cbc/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "NestJS/Fastify status and disabled-by-default VRSCTEST linking API",
  "license": "Apache-2.0",
  "main": "dist/main.js",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@cbc/auth": "workspace:*",
    "@cbc/config": "workspace:*",
    "@cbc/contracts": "workspace:*",
    "@cbc/db": "workspace:*",
    "@cbc/observability": "workspace:*",
    "@cbc/verus": "workspace:*",
    "@cbc/verus-linking": "workspace:*",
    "@fastify/cors": "11.3.0",
    "@fastify/helmet": "13.1.0",
    "@nestjs/common": "11.2.7",
    "@nestjs/core": "11.2.7",
    "@nestjs/platform-fastify": "11.2.7",
    "@nestjs/swagger": "11.4.7",
    "fastify": "5.12.7",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2"
  }
}
