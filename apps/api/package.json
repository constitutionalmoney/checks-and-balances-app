{
  "name": "@cbc/api",
  "version": "0.0.0",
  "private": true,
  "description": "NestJS/Fastify health and protocol-status shell",
  "license": "Apache-2.0",
  "main": "dist/main.js",
  "scripts": {
    "dev": "tsx watch src/main.ts",
