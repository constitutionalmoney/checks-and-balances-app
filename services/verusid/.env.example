# CBC VerusID authentication service. Copy to .env only for local operation.
# Never commit real values. All three secrets below must be distinct.
NODE_ENV=production
HOST=0.0.0.0
PORT=3001
TRUST_PROXY_HOPS=1

# These trust-contract values are intentionally immutable in v1.
CHAIN=vrsctest
CHAIN_IADDRESS=iJhCezBExJHvtyH3fGhNnt2NhU4Ztkf2yq
SIGNING_IADDRESS=iBN1aqx6nYhm71h9UkGsW9mhU6trADx4WP
SERVER_URL=https://auth.checksandbalances.services
CALLBACK_URL=https://auth.checksandbalances.services/verusidlogin
CONTRACT_VERSION=cbc-verusid-auth.v1
JWT_ISSUER=checks-and-balances-verusid-auth
CBC_ALLOWED_AUDIENCES=cbc-participant-app,cbc-committee-console

# Secret-manager values. Do not put any of them in a deep link, URL, log, or browser response.
PRIVATE_KEY=
JWT_SECRET=
CBC_CLIENT_SECRET=

# Durable one-time state and pinned public, read-only VRSCTEST reads.
REDIS_URL=redis://127.0.0.1:6379/0
VERUS_RPC_URL=https://api.verustest.net

# Immutable deployment evidence. Use full commits and the deployed image digest.
SERVICE_SOURCE_REVISION=
IMAGE_DIGEST=
VERUSID_TS_CLIENT_COMMIT=48a1d48a5d076f313022a5891986339851ad7c0c
VERUS_PRIMITIVES_COMMIT=30c951804228a285546a45457be57ead39d90888
VERUSD_RPC_CLIENT_COMMIT=fd2c6b0d35d468ee6174bcdd569f5aa990b05282
VERUS_BITGO_COMMIT=7c754d4a5920198d9fe6827d3e23bd5cf431f264
VERUSD_VERSION=v1.2.17-3
