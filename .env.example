# Local-only, synthetic defaults. Copy to .env only for local development.
CBC_ENVIRONMENT=local
CBC_PROTOCOL_STAGE=specification
CBC_RELEASE_STATUS=not_operational
CBC_VERUS_NETWORK=FAKE
CBC_VERUS_RPC_URL=http://127.0.0.1:18080
CBC_VERUS_RPC_USER=
CBC_VERUS_RPC_PASSWORD=
DATABASE_URL=postgresql://cbc:cbc_local_only@127.0.0.1:55432/cbc
REDIS_URL=redis://127.0.0.1:56379
CBC_PARTICIPANT_SESSION_AUDIENCE=cbc-participant-app
CBC_COMMITTEE_SESSION_AUDIENCE=cbc-committee-console
CBC_PARTICIPANT_ORIGIN=http://localhost:3100
CBC_COMMITTEE_ORIGIN=http://localhost:3101
CBC_PARTICIPANT_RELYING_PARTY_ID=localhost
CBC_COMMITTEE_RELYING_PARTY_ID=localhost
CBC_PARTICIPANT_AUTH_SECRET=local-only-participant-auth-secret-change-me
CBC_COMMITTEE_AUTH_SECRET=local-only-committee-auth-secret-change-me-now
CBC_RATE_LIMIT_SECRET=local-only-rate-limit-secret-change-me-now
CBC_PARTICIPANT_SESSION_KEY_VERSION=local-p-v1
CBC_COMMITTEE_SESSION_KEY_VERSION=local-c-v1
CBC_LOG_LEVEL=info

# All unfinished, public, sensitive, and mainnet capabilities start disabled.
CBC_PUBLIC_DIRECTORY_ENABLED=false
CBC_PUBLIC_SESSIONS_ENABLED=false
CBC_VERUS_LINKING_ENABLED=false
# Required together only when optional VRSCTEST linking is explicitly enabled.
CBC_VERUS_LINK_APPLICATION_IDENTITY=iMUw5xvWkC7qsCzgxi2um9YRCmugmBhBfm
CBC_VERUS_AUTH_URL=https://auth.checksandbalances.services
CBC_VERUS_AUTH_CALLBACK_URL=https://auth.checksandbalances.services/verusidlogin
CBC_VERUS_AUTH_SERVICE_VERSION=1.1.0
CBC_VERUS_AUTH_ISSUER=checks-and-balances-verusid-auth
CBC_VERUS_AUTH_CONTRACT_VERSION=cbc-verusid-auth.v1
CBC_VERUS_AUTH_SOURCE_REVISION=
CBC_VERUS_AUTH_IMAGE_DIGEST=
CBC_VERUS_AUTH_SDK_COMMIT=48a1d48a5d076f313022a5891986339851ad7c0c
CBC_VERUS_AUTH_PRIMITIVES_COMMIT=30c951804228a285546a45457be57ead39d90888
CBC_VERUS_AUTH_RPC_CLIENT_COMMIT=fd2c6b0d35d468ee6174bcdd569f5aa990b05282
CBC_VERUS_AUTH_BITGO_COMMIT=7c754d4a5920198d9fe6827d3e23bd5cf431f264
CBC_VERUS_AUTH_DAEMON_VERSION=v1.2.17-3
CBC_VERUS_AUTH_CLIENT_SECRET=
CBC_VERUS_AUTH_JWT_SECRET=
CBC_VERUS_LINK_BINDING_SECRET=
CBC_VERUS_LINK_POLLING_SECRET=
CBC_VERUS_IDENTITY_UPDATE_ENABLED=false
CBC_COMMITTEE_SIGNING_ENABLED=false
CBC_RANDOM_RENEWAL_ENABLED=false
CBC_RMR_ADAPTER_ENABLED=false
CBC_MAINNET_WRITES_ENABLED=false
CBC_DOCUMENT_UPLOAD_ENABLED=false
CBC_UNIQUENESS_CLAIM_ENABLED=false
CBC_LOCALITY_CLAIM_ENABLED=false
